# --- Trinity (read-only) ------------------------------------------------------------------
# The Trinity MCP endpoint and an MCP key (tmcp_live_...). Use a read-only key for this service.
TRINITY_MCP_URL=
TRINITY_MCP_TOKEN=
# How the key is sent. Defaults produce "Authorization: Bearer <token>".
TRINITY_AUTH_HEADER=Authorization
TRINITY_AUTH_SCHEME=Bearer
TICKET_URL_TEMPLATE=https://trinity-base.internal.emergent.host/tickets/{id}

# --- Classifier (theme 1) ------------------------------------------------------------------
# Which model reads the reply (option A: von + decider:4b in local Ollaya, option B: Jev) is chosen in
# config.py PENDING_MODEL. This file only holds the Jev key and the shared tuning below.
# systemone = the decision model chosen in config.py. claude = the Anthropic API for every reply.
CLASSIFIER_BACKEND=systemone
# Jev via Emergent LiteLLM: theme 1 option B, and theme 6 (6a L3 escalation check, 6b escalation note).
JEV_API_KEY=
# Per-reply time limit (a 4B model on a CPU can take 10-60 s under load).
SYSTEMONE_TIMEOUT_SECONDS=300
# Scores in [LOW, HIGH) are uncertain: sent to the fallback if set, otherwise no alert (see ALERT_UNCERTAIN).
SYSTEMONE_LOW=0.4
SYSTEMONE_HIGH=0.6
# none | claude (needs ANTHROPIC_API_KEY; only uncertain replies are sent to it)
SYSTEMONE_FALLBACK=none
# Replies the model can't judge get the benefit of the doubt: no alert, logged as 'skipped: uncertain'.
# true = alert on them too, marked low confidence.
ALERT_UNCERTAIN=false

# Claude: theme 6 fallback (cases Jev cannot settle), and optional theme-1 backend / fallback.
# Optional: without it the fallback is off (one warning at start, no error).
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-opus-5-5
CLASSIFIER_EFFORT=low
# Server-side refusal fallback (Claude API only). Set false on Bedrock/Vertex/Foundry.
CLASSIFIER_FALLBACKS=true

# --- Slack --------------------------------------------------------------------------------
# Bot scopes: chat:write, users:read, users:read.email. Invite the bot to the channel.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#ticket-hygiene
# true = print alerts to stdout instead of posting. Keep true until a backtest looks right.
DRY_RUN=true

# --- Behaviour ----------------------------------------------------------------------------
TEAMS_FILE=config/teams.yaml
STATE_DB=state.db
# Polling mode (`run`) only: how often to scan Trinity for changes.
POLL_SECONDS=60

# --- Event-driven mode (`serve`) ----------------------------------------------------------
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Shared secret; Trinity sends it as the X-Webhook-Token header (or ?token= for Pub/Sub push).
WEBHOOK_TOKEN=
# Safety-net sweep for events that were lost or never sent.
RECONCILE_MINUTES=15
# How often to look for checks whose grace period has ended (local only, no Trinity calls).
DUE_TICK_SECONDS=15
# On the very first start, how far back to look (0 = only events from now on).
INITIAL_LOOKBACK_MINUTES=0
# Wait this long after the triggering event before judging it (lets the reply / a revert land).
PENDING_GRACE_MINUTES=5
# Theme 1: a reply sent up to this long after the PENDING change still counts; with no reply yet,
# the check is repeated every 5 minutes until this window closes, then alerts.
PENDING_REPLY_WINDOW_MINUTES=30
REASSIGN_GRACE_MINUTES=5
# Theme 2 ignores taking a ticket the colleague held for less than this (simultaneous-claim races).
REASSIGN_MIN_HOLD_MINUTES=2
CLOSE_GRACE_MINUTES=1
# Authors with these email domains count as engineers; everything else is System/Overwatch/customer.
HUMAN_EMAIL_DOMAINS=emergent.sh
# Which checks run, and their thresholds, are set in config.py (project root), not here.

# --- Dashboard (python -m dashboard; layout and port in config.py DASHBOARD) -----------------
# OAuth client id from Google Cloud console (APIs & Services > Credentials > OAuth client ID, type
# "Web application"). Add the dashboard's address under "Authorized JavaScript origins", e.g.
# http://localhost:8090 now and the https address once deployed. No client secret is needed.
GOOGLE_CLIENT_ID=
# true = a "local sign-in" box for any allow-listed email, only from this machine (127.0.0.1).
# For testing before GOOGLE_CLIENT_ID exists. Never set this on a shared server.
DASHBOARD_DEV_LOGIN=false
# Overrides config.py DASHBOARD["host"] (e.g. 0.0.0.0 when deployed behind https); PORT overrides the port.
DASHBOARD_HOST=
